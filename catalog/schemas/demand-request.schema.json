{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/hutchfinity/demand-request.schema.json",
  "title": "Hutchfinity neutral demand request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifest_id", "as_of", "artifact_demands"],
  "properties": {
    "manifest_id": {"type": "string", "minLength": 1},
    "as_of": {"type": "string", "format": "date-time"},
    "artifact_demands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["item_class_id", "required_quantity", "allowed_materials", "allowed_colors", "priority_class"],
        "properties": {
          "item_class_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "required_quantity": {"type": "integer", "minimum": 1},
          "allowed_materials": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "allowed_colors": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "priority_class": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
